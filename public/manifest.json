{
  "manifest_version": 3,
  "name": "描图纸 Tracing Paper",
  "short_name": "描图纸",
  "version": "3.0.0",
  "description": "把设计稿像描图纸一样覆盖在网页上：多图层拖动缩放、透明度与混合模式比对、像素级差异定位，并把结果整理成可交给 AI / CI 的报告。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "描图纸 Tracing Paper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-gray16.png",
      "32": "icons/icon-gray32.png",
      "48": "icons/icon-gray48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "打开 / 收起描图纸工具栏"
    }
  }
}
